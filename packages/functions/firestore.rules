rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isAdmin(companyId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/companies/$(companyId)/admins/$(request.auth.uid)).exists;
    }
    function isGuestEmail(email) {
      return request.auth != null && request.auth.token.email == email;
    }
    match /companies/{companyId} {
      allow read: if true;
      allow write: if isAdmin(companyId);
      match /properties/{propertyId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin(companyId);
        match /rooms/{roomId} {
          allow read: if true;
          allow create: if true;
          allow update, delete: if isAdmin(companyId);
        }
        match /bookings/{bookingId} {
          allow read: if isAdmin(companyId) || isGuestEmail(resource.data.guestEmail);
          allow create: if true;
          allow update: if isAdmin(companyId) || isGuestEmail(resource.data.guestEmail);
          match /payments/{paymentId} {
            allow read: if isAdmin(companyId) || isGuestEmail(get(/databases/$(database)/documents/companies/$(companyId)/properties/$(propertyId)/bookings/$(bookingId)).data.guestEmail);
            allow create: if true;
            allow update, delete: if isAdmin(companyId);
          }
        }
        match /availability/{date} {
          allow read: if true;
          allow write: if isAdmin(companyId);
        }
        match /icalSync/{syncId} {
          allow read, write: if isAdmin(companyId);
        }
      }
      match /admins/{userId} {
        allow read, write: if request.auth.uid == userId || isAdmin(companyId);
      }
      match /webhookLogs/{logId} {
        allow read, write: if isAdmin(companyId);
      }
    }
  }
}
